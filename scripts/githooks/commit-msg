#!/bin/sh
# sale-check privacy guard — scans the commit message for PII / secrets too
# (a pasted promo code / URL / token in a message is as permanent as in a file).
# Bypass deliberately with: git commit --no-verify
if command -v python >/dev/null 2>&1; then
  PY=python
elif command -v py >/dev/null 2>&1; then
  PY=py
else
  exit 0  # message scan is best-effort; pre-commit already failed loudly
fi
exec "$PY" scripts/check_pii.py --file "$1"
