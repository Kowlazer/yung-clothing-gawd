# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# Google Doc watchlist URL (share link). The script derives the export URL from this.
WATCHLIST_URL=https://docs.google.com/document/d/YOUR_DOC_ID/edit?usp=sharing

# Resend API key — https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# From/to for the digest email
FROM_EMAIL=onboarding@resend.dev
TO_EMAIL=you@example.com

# GitHub personal access token scoped to "gist" only (read + write your own gists)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# ID of the secret GitHub Gist that stores prices.json, shop_aliases.json, codes.json
GIST_ID=xxxxxxxxxxxxxxxxxxxx

# Anthropic API key for the fuzzy-bits Claude calls
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Gmail IMAP credentials for the Promotions-tab signal source (issue #9).
# Generate the app password at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled). The 16-char password is shown with
# spaces for readability — paste either form; gmail.py strips them.
GMAIL_USERNAME=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# BodySpec account login — OPTIONAL. Only needed for the wardrobe body-comp
# backfill (`python -m src.order_scan --backfill-bodycomp`), which pulls your
# DEXA scan metrics from https://app.bodyspec.com and stamps the scan closest
# to each item's purchase date onto the wardrobe. The daily cron never uses
# these. Your normal BodySpec website email + password.
BODYSPEC_USERNAME=you@example.com
BODYSPEC_PASSWORD=your-bodyspec-password

# Shops whose purchases are kept out of the wardrobe entirely — OPTIONAL.
# Comma-separated; matched case-insensitively against the shop name AND domain
# (punctuation-insensitive, so "Nocturne Goods" catches nocturne-goods.com). The
# order scanner never ingests their order/shipping emails and hard-deletes any
# items already stored on its next run. Blank/unset = nothing excluded.
EXCLUDED_SHOPS=

# Restock-notification auto-signup — OPTIONAL, manual command, OFF by default.
# `python -m src.restock_signup` opens watchlist products that are out of stock
# (esp. in your preferred size) in headless Chromium and signs up for the
# "email me when back in stock" alert. Like the newsletter signup it refuses to
# run unless this is set truthy; the daily cron ignores it. Signup email reuses
# GMAIL_USERNAME. `--list-targets` previews the OOS targets without it set.
RESTOCK_SIGNUP_ENABLED=0

# Back-in-stock EMAIL detection in the daily digest — OPTIONAL, ON by default.
# Detects "your item is back in stock" emails and folds them into the digest's
# "Back in stock" section (tagged as email alerts). Set 0/false/no/off to
# disable. RESTOCK_EMAIL_DAYS is the recent window those lines cover (default 7).
RESTOCK_EMAILS_DAILY=1
RESTOCK_EMAIL_DAYS=7

# Shadow A/B model for the daily Claude fuzzy call — OPTIONAL, off by default
# (cost lever #5, issue #16). When set, the identical batched payload is ALSO
# judged by this model and the verdict diff logged to shadow_runs.json in the
# Gist; review with `python -m src.shadow_report` before swapping the primary
# model. The digest is never affected. In production this lives as a plain env
# line in .github/workflows/daily.yml rather than a secret.
#SHADOW_MODEL=claude-haiku-4-5-20251001
